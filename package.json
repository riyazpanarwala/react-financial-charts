{
    "name": "root",
    "private": true,
    "author": "Riyaz Panarwala",
    "license": "ISC",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "buildPackage": "run-s build:utils build:core build:scales build:coordinates build:axes build:series build:indicators build:annotations build:interactive build:tooltip build:charts",
        "build:annotations": "npm run build --workspace=packages/annotations",
        "build:axes": "npm run build --workspace=packages/axes",
        "build:charts": "npm run build --workspace=packages/charts",
        "build:coordinates": "npm run build --workspace=packages/coordinates",
        "build:core": "npm run build --workspace=packages/core",
        "build:indicators": "npm run build --workspace=packages/indicators",
        "build:interactive": "npm run build --workspace=packages/interactive",
        "build:scales": "npm run build --workspace=packages/scales",
        "build:series": "npm run build --workspace=packages/series",
        "build:tooltip": "npm run build --workspace=packages/tooltip",
        "build:utils": "npm run build --workspace=packages/utils",
        "clean": "run-s clean:packages clean:modules",
        "clean:packages": "npm run clean --workspaces",
        "clean:modules": "npm run clean --workspaces",
        "convert": "npm run link",
        "docs": "run-s buildPackage docs:stories",
        "docs:stories": "npm run docs --workspace=packages/stories",
        "link": "npm link",
        "lint": "eslint . --quiet",
        "lint:fix": "eslint . --quiet --fix",
        "start": "run-p watch start:stories",
        "start:stories": "npm run start --workspace=packages/stories",
        "test": "npm run test --workspaces",
        "prestart": "npm run buildPackage",
        "prepublishOnly": "npm run buildPackage",
        "publish": "npm publish --workspaces",
        "prepare-publish": "node update-dependencies.js",
        "publish-all": "node publish.js",
        "npmRelease": "npm run prepare-publish && npm run publish-all",
        "release": "npm version",
        "release:pre": "npm version --preid=pre",
        "release:grad": "npm version --preid=grad",
        "watch": "run-p watch:*",
        "watch:annotations": "npm --workspace=packages/annotations run watch",
        "watch:axes": "npm --workspace=packages/axes run watch",
        "watch:coordinates": "npm --workspace=packages/coordinates run watch",
        "watch:core": "npm --workspace=packages/core run watch",
        "watch:indicators": "npm --workspace=packages/indicators run watch",
        "watch:interactive": "npm --workspace=packages/interactive run watch",
        "watch:scales": "npm --workspace=packages/scales run watch",
        "watch:series": "npm --workspace=packages/series run watch",
        "watch:tooltip": "npm --workspace=packages/tooltip run watch",
        "watch:utils": "npm --workspace=packages/utils run watch"
    },
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@babel/core": "^7.13.1",
        "@chromatic-com/storybook": "^3.2.2",
        "@eslint/js": "^9.17.0",
        "@storybook/addon-essentials": "^8.4.7",
        "@storybook/addon-interactions": "^8.4.7",
        "@storybook/addon-onboarding": "^8.4.7",
        "@storybook/blocks": "^8.4.7",
        "@storybook/react": "^8.4.7",
        "@storybook/react-vite": "^8.4.7",
        "@types/d3-array": "^2.9.0",
        "@types/d3-dsv": "^2.0.1",
        "@types/d3-force": "^2.1.1",
        "@types/d3-format": "^2.0.0",
        "@types/d3-interpolate": "^3.0.4",
        "@types/d3-path": "^2.0.0",
        "@types/d3-scale": "^4.0.8",
        "@types/d3-selection": "^2.0.0",
        "@types/d3-shape": "^2.0.0",
        "@types/d3-time-format": "^3.0.0",
        "@types/lodash.flattendeep": "^4.4.6",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^8.18.2",
        "@typescript-eslint/parser": "^8.18.2",
        "babel-loader": "^8.2.2",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-react": "^7.37.3",
        "find-cache-dir": "3.3.1",
        "globals": "^15.14.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^2.8.8",
        "rimraf": "^5.0.0",
        "source-map-loader": "^1.1.0",
        "ts-loader": "^9.5.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2"
    },
    "dependencies": {
        "@riyazpanarwala/annotations": "workspace:*",
        "@riyazpanarwala/axes": "workspace:*",
        "@riyazpanarwala/coordinates": "workspace:*",
        "@riyazpanarwala/core": "workspace:*",
        "@riyazpanarwala/indicators": "workspace:*",
        "@riyazpanarwala/interactive": "workspace:*",
        "@riyazpanarwala/scales": "workspace:*",
        "@riyazpanarwala/series": "workspace:*",
        "@riyazpanarwala/stories": "workspace:*",
        "@riyazpanarwala/tooltip": "workspace:*",
        "@riyazpanarwala/utils": "workspace:*",
        "@riyazpanarwala/react-financial-charts": "workspace:*"
    }
}
